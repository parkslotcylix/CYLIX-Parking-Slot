{
  "enabled": true,
  "name": "Auto-Update Modal Styles",
  "description": "Automatically applies landscape layout and styling updates to admin management modals whenever the file is edited",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "templates/admin_management.html"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Verify that the admin_management.html modals maintain: 1) Landscape 2-column grid layout (#adminForm with grid-template-columns: 1fr 1fr), 2) Full-width fields for profile picture, password, and buttons (grid-column: 1 / -1), 3) Modal width of 900px max, 4) Responsive design for mobile (<768px stacks to 1 column), 5) 16px gap between grid items. If any of these are missing or changed, restore them to ensure consistency. Report what was verified or fixed."
  }
}